# ===== Dutch Learning Bot — Environment Variables =====
# این فایل را به .env کپی کنید و مقادیر واقعی را وارد کنید.
# هرگز فایل .env را در گیت commit نکنید.

# --- Telegram ---
# توکن ربات از @BotFather (فرمت: 123456789:ABCdef...)
BOT_TOKEN=123456789:replace-with-your-real-token
# شناسه‌ی عددی ادمین‌ها، با کاما جدا شود (از @userinfobot بگیرید)
ADMIN_USER_ID=123456789

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./bot.db
DB_POOL_SIZE=5
# دیتابیس کتابخانه‌ی واژگان B2 (فقط-خواندنی). خالی بگذارید تا این قابلیت غیرفعال شود.
# فرمت: postgresql+asyncpg://user:password@host:port/dbname
VOCAB_DATABASE_URL=

# --- OpenAI / AI ---
OPENAI_API_KEY=sk-replace-with-your-key
OPENAI_MODEL_DEFAULT=gpt-4o-mini
OPENAI_MAX_TOKENS=800
AI_COST_LIMIT_PER_USER_PER_DAY=0.10

# --- Chat feature (چت با AI button) — optional separate provider ---
# خالی بگذارید تا از OPENAI_API_KEY / OPENAI_MODEL_DEFAULT بالا استفاده کند.
# برای NVIDIA build.nvidia.com (یا هر endpoint سازگار با OpenAI):
AI_CHAT_API_KEY=
AI_CHAT_BASE_URL=
AI_CHAT_MODEL=

# --- Deepgram (Speech-to-Text برای تشخیص درستیِ جمله) ---
# کلید از https://console.deepgram.com — برای آزمایش تلفظ با Nova-3 هلندی
DEEPGRAM_API_KEY=replace-with-your-deepgram-key

# --- FSRS (Spaced Repetition) ---
DESIRED_RETENTION=0.9
MAX_DAILY_REVIEWS=50

# --- Notifications ---
NOTIFICATION_ENABLED_HOURS_START=8
NOTIFICATION_ENABLED_HOURS_END=22
