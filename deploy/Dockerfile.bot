# Telegram bot (aiogram long-polling). No published ports — outbound only.
# Required pre-start deploy step (using either image):
#   python -m database.migrations
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

COPY deploy/requirements-bot.txt /app/requirements-bot.txt
RUN pip install --no-cache-dir -r requirements-bot.txt

COPY bot/ /app/bot/
COPY database/ /app/database/
COPY handlers/ /app/handlers/
COPY keyboards/ /app/keyboards/
COPY middlewares/ /app/middlewares/
COPY services/ /app/services/
COPY utils/ /app/utils/
COPY scripts/ /app/scripts/
COPY Questions/ /app/Questions/

CMD ["python", "-m", "bot.main"]
