# Membership website (FastAPI + Mollie iDEAL). Built on the server.
# Required pre-start deploy step (using either image):
#   python -m database.migrations
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

COPY deploy/requirements-web.txt /app/requirements-web.txt
RUN pip install --no-cache-dir -r requirements-web.txt

# Only the modules the website imports (bot.config, database, the subscription
# service, token util, and the webapp itself). The bot's handlers/loader are
# copied as part of bot/ but never imported here.
COPY bot/ /app/bot/
COPY database/ /app/database/
COPY services/ /app/services/
COPY utils/ /app/utils/
COPY webapp/ /app/webapp/

EXPOSE 8000

CMD ["uvicorn", "webapp.main:app", "--host", "0.0.0.0", "--port", "8000", \
     "--proxy-headers", "--forwarded-allow-ips", "*"]
